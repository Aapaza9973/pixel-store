<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <!-- Estos archivos viven en el suite `gate`. Se excluyen acá para
                 que la suite completa no los corra dos veces.
                 Ver docs/07-testing.md. -->
            <exclude>tests/Feature/UserManagementTest.php</exclude>
            <exclude>tests/Feature/UserPolicyTest.php</exclude>
            <exclude>tests/Feature/UserObserverTest.php</exclude>
            <exclude>tests/Feature/UserHistorialTest.php</exclude>
            <exclude>tests/Feature/UserPanelHomeTest.php</exclude>
            <exclude>tests/Feature/StoreUserRequestTest.php</exclude>
            <exclude>tests/Feature/UpdateUserRequestTest.php</exclude>
            <exclude>tests/Feature/RoleAccessTest.php</exclude>
            <exclude>tests/Feature/InventarioAccessTest.php</exclude>
            <exclude>tests/Feature/MensajesContextualesTest.php</exclude>
            <exclude>tests/Feature/AuditoriaLoginTest.php</exclude>
            <exclude>tests/Feature/SessionExtendTest.php</exclude>
            <exclude>tests/Feature/Auth/AuthenticationTest.php</exclude>
            <exclude>tests/Feature/Auth/LoginRedirectTest.php</exclude>
            <exclude>tests/Feature/Auth/LoginValidationTest.php</exclude>
        </testsuite>
        <!-- Gate ejecutable de HU-1.1 (usuarios) y HU-RF.4 (login/roles/acceso).
             Es una lista cerrada: agregar un archivo acá es una decisión explícita.
             Ver docs/07-testing.md. -->
        <testsuite name="gate">
            <file>tests/Feature/UserManagementTest.php</file>
            <file>tests/Feature/UserPolicyTest.php</file>
            <file>tests/Feature/UserObserverTest.php</file>
            <file>tests/Feature/UserHistorialTest.php</file>
            <file>tests/Feature/UserPanelHomeTest.php</file>
            <file>tests/Feature/StoreUserRequestTest.php</file>
            <file>tests/Feature/UpdateUserRequestTest.php</file>
            <file>tests/Feature/RoleAccessTest.php</file>
            <file>tests/Feature/InventarioAccessTest.php</file>
            <file>tests/Feature/MensajesContextualesTest.php</file>
            <file>tests/Feature/AuditoriaLoginTest.php</file>
            <file>tests/Feature/SessionExtendTest.php</file>
            <file>tests/Feature/Auth/AuthenticationTest.php</file>
            <file>tests/Feature/Auth/LoginRedirectTest.php</file>
            <file>tests/Feature/Auth/LoginValidationTest.php</file>
            <file>tests/Feature/ShopCatalogoTest.php</file>

        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="pixel_store_test"/>
        <env name="DB_USERNAME" value="postgres"/>
        <env name="DB_PASSWORD" value="Franco_2201"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
